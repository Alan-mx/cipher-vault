<UserControl x:Class="CipherVault.Ui.Wpf.AccessGrantManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TotalCountText" Grid.Column="0" Text="总数 0" Margin="0,0,18,0" />
            <TextBlock x:Name="ActiveCountText" Grid.Column="1" Text="有效 0" Margin="0,0,18,0" Foreground="#067647" />
            <TextBlock x:Name="RevokedCountText" Grid.Column="2" Text="已撤销 0" Margin="0,0,18,0" Foreground="#B42318" />
            <TextBlock x:Name="ExpiredCountText" Grid.Column="3" Text="已过期 0" Margin="0,0,18,0" Foreground="#667085" />
            <TextBlock x:Name="VaultStateText" Grid.Column="4" HorizontalAlignment="Right" Foreground="#667085" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="StateFilterComboBox" Grid.Column="0" Width="120" MinHeight="30"
                      SelectedIndex="0" SelectionChanged="StateFilterComboBox_SelectionChanged">
                <ComboBoxItem Content="全部" Tag="" />
                <ComboBoxItem Content="有效" Tag="active" />
                <ComboBoxItem Content="已撤销" Tag="revoked" />
                <ComboBoxItem Content="已过期" Tag="expired" />
            </ComboBox>
            <TextBox x:Name="SearchTextBox" Grid.Column="1" MinHeight="30" Margin="8,0,0,0"
                     Padding="8,4" KeyDown="SearchTextBox_KeyDown" />
            <Button x:Name="SearchButton" Grid.Column="2" Content="搜索" MinWidth="80"
                    Margin="8,0,0,0" Click="SearchButton_Click" />
            <Button x:Name="RefreshButton" Grid.Column="3" Content="刷新" MinWidth="80"
                    Margin="8,0,0,0" Click="RefreshButton_Click" />
            <Button x:Name="RevokeAllButton" Grid.Column="4" Content="撤销全部" MinWidth="90"
                    Margin="8,0,0,0" IsEnabled="False" Click="RevokeAllButton_Click" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="#667085"
                       Text="尚未加载授权。" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button x:Name="LoadMoreButton" Grid.Column="1" Content="加载更多" MinWidth="90"
                    IsEnabled="False" Click="LoadMoreButton_Click" />
        </Grid>

        <DataGrid x:Name="GrantsGrid" Grid.Row="3" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False"
                  SelectionChanged="GrantsGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="客户端" Binding="{Binding ClientDisplayName}" Width="120" />
                <DataGridTextColumn Header="稳定标识" Binding="{Binding ClientId}" Width="130" />
                <DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="90" />
                <DataGridTextColumn Header="权限" Binding="{Binding OperationsText}" Width="120" />
                <DataGridTextColumn Header="资源范围" Binding="{Binding ResourceScopesText}" Width="2*" />
                <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAtText}" Width="155" />
                <DataGridTextColumn Header="到期时间" Binding="{Binding HardExpiresAtText}" Width="155" />
                <DataGridTextColumn Header="最后使用" Binding="{Binding LastUsedAtText}" Width="155" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="4" Margin="0,10,0,0" Padding="12"
                BorderBrush="#D0D5DD" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,8">
                    <TextBlock Text="Grant ID" FontWeight="SemiBold" />
                    <TextBlock x:Name="DetailGrantIdText" Text="未选择" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,8">
                    <TextBlock Text="客户端" FontWeight="SemiBold" />
                    <TextBlock x:Name="DetailClientText" Text="未选择" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                    <TextBlock Text="状态" FontWeight="SemiBold" />
                    <TextBlock x:Name="DetailStateText" Text="未选择" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,8">
                    <TextBlock Text="时间" FontWeight="SemiBold" />
                    <TextBlock x:Name="DetailTimeText" Text="-" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,8">
                    <TextBlock Text="请求权限 / 实际权限" FontWeight="SemiBold" />
                    <TextBlock x:Name="DetailOperationsText" Text="-" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                    <TextBlock Text="资源范围" FontWeight="SemiBold" />
                    <TextBlock x:Name="DetailScopesText" Text="-" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                    <TextBlock Text="撤销信息" FontWeight="SemiBold" />
                    <TextBlock x:Name="DetailRevocationText" Text="-" TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="RevokeButton" Grid.Row="2" Grid.Column="2"
                        Content="撤销此授权" MinWidth="120" HorizontalAlignment="Right"
                        VerticalAlignment="Bottom" IsEnabled="False"
                        Click="RevokeButton_Click" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
