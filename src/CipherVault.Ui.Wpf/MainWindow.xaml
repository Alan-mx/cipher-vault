<Window x:Class="CipherVault.Ui.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CipherVault 加密资料库"
        Width="1060"
        Height="760"
        MinWidth="900"
        MinHeight="650"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="CipherVault 加密资料库" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Background="#EEF2F7" CornerRadius="4" Padding="12,6" HorizontalAlignment="Right">
                <TextBlock x:Name="StatusText" Text="已锁定" FontWeight="SemiBold" Foreground="#344054" />
            </Border>
        </DockPanel>

        <TabControl x:Name="MainTabs" Grid.Row="1" SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="资料库">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="本地加密的 Markdown 和 TXT。一次授权仅对当前进程会话有效。"
                               Foreground="#667085"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16" />
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="资料库文件夹" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox x:Name="VaultPathTextBox" Grid.Column="1" MinHeight="32" Padding="8,4" VerticalContentAlignment="Center" />
                        <Button Grid.Column="2" Content="初始化" MinWidth="100" Margin="12,0,0,0" Padding="12,5" Click="InitializeButton_Click" />
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CredentialTypeComboBox" Width="110" MinHeight="32"
                                  Margin="0,0,12,0" SelectedIndex="0"
                                  SelectionChanged="CredentialTypeComboBox_SelectionChanged">
                            <ComboBoxItem Content="密码" />
                            <ComboBoxItem Content="恢复密钥" />
                        </ComboBox>
                        <PasswordBox x:Name="PasswordBox" Grid.Column="1" MinHeight="32" Padding="8,4" VerticalContentAlignment="Center" />
                        <PasswordBox x:Name="RecoveryKeyUnlockBox" Grid.Column="1" MinHeight="32"
                                     Padding="8,4" VerticalContentAlignment="Center" FontFamily="Consolas"
                                     Visibility="Collapsed" ToolTip="可粘贴离线恢复密钥，空格和连字符会自动忽略。" />
                        <Button Grid.Column="2" Content="解锁" MinWidth="90" Margin="12,0,0,0" Padding="12,5" Click="UnlockButton_Click" />
                        <Button Grid.Column="3" Content="锁定" MinWidth="90" Margin="8,0,0,0" Padding="12,5" Click="LockButton_Click" />
                    </Grid>
                    <StackPanel Grid.Row="3">
                        <Border x:Name="RecoveryPanel"
                                Visibility="Collapsed"
                                BorderBrush="#D0D5DD"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="16"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="保存离线恢复密钥" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock Margin="0,6,0,10" Foreground="#667085" TextWrapping="Wrap"
                                           Text="请将其保存在本机之外，且不要放在资料库备份中。密钥只在初始化或轮换时显示一次。" />
                                <TextBox x:Name="RecoveryKeyTextBox" IsReadOnly="True" TextWrapping="Wrap"
                                         MinHeight="60" Padding="8" FontFamily="Consolas" />
                                <Button Content="复制密钥" HorizontalAlignment="Left" Margin="0,8,0,10"
                                        Padding="10,4" Click="CopyRecoveryButton_Click" />
                                <TextBlock Text="重新输入恢复密钥以确认已保存：" />
                                <TextBox x:Name="RecoveryConfirmTextBox" MinHeight="32" Padding="8,4" Margin="0,6,0,0" />
                                <Button Content="确认恢复密钥" HorizontalAlignment="Left" Margin="0,8,0,0"
                                        Padding="12,5" Click="ConfirmRecoveryButton_Click" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="SessionDetailText" Foreground="#475467" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="浏览">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="220" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchTextBox" Grid.Column="0" MinHeight="30" Padding="8,4" />
                        <Button Grid.Column="1" Content="搜索" MinWidth="80" Margin="8,0,0,0" Click="SearchButton_Click" />
                        <Button Grid.Column="2" Content="刷新" MinWidth="80" Margin="8,0,0,0" Click="RefreshCatalogButton_Click" />
                        <Button x:Name="LoadMoreCatalogButton" Grid.Column="3" Content="加载更多" MinWidth="100"
                                Margin="8,0,0,0" IsEnabled="False" Click="LoadMoreCatalogButton_Click" />
                    </Grid>
                    <TextBlock x:Name="CatalogSummaryText" Grid.Row="1" Foreground="#667085"
                               Margin="0,0,0,8" Text="尚未加载资料库。" />
                    <DataGrid x:Name="CatalogGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionChanged="CatalogGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="2*" />
                            <DataGridTextColumn Header="虚拟路径" Binding="{Binding VirtualPath}" Width="3*" />
                            <DataGridTextColumn Header="版本" Binding="{Binding Revision}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBox x:Name="DocumentViewer" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Margin="0,10,0,0" Padding="10" FontFamily="Consolas" />
                </Grid>
            </TabItem>

            <TabItem Header="回收站">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="刷新" MinWidth="80" Click="RefreshTrashButton_Click" />
                        <Button Content="恢复" MinWidth="80" Margin="8,0,0,0" Click="RestoreTrashButton_Click" />
                        <Button Content="永久删除" MinWidth="120" Margin="8,0,0,0" Click="PurgeButton_Click" />
                        <Button x:Name="LoadMoreTrashButton" Content="加载更多" MinWidth="100"
                                Margin="8,0,0,0" IsEnabled="False" Click="LoadMoreTrashButton_Click" />
                        <TextBlock x:Name="TrashSummaryText" Foreground="#667085" VerticalAlignment="Center"
                                   Margin="12,0,0,0" Text="尚未加载回收站。" />
                    </StackPanel>
                    <DataGrid x:Name="TrashGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="2*" />
                            <DataGridTextColumn Header="虚拟路径" Binding="{Binding VirtualPath}" Width="3*" />
                            <DataGridTextColumn Header="清理时间" Binding="{Binding PurgeAfter}" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="维护">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="当前密码" />
                        <PasswordBox x:Name="MaintenancePasswordBox" MinHeight="30" Padding="8,4" Margin="0,4,0,12" />

                        <TextBlock Text="从 Markdown/TXT 文件夹导入" FontWeight="SemiBold" />
                        <DockPanel Margin="0,6,0,8">
                            <Button Content="选择文件夹" MinWidth="90" DockPanel.Dock="Left" Click="BrowseImportButton_Click" />
                            <TextBox x:Name="ImportSourceTextBox" Margin="8,0,0,0" MinHeight="30" Padding="8,4" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="预览导入" MinWidth="110" Click="ImportPreviewButton_Click" />
                            <Button Content="应用预览" MinWidth="110" Margin="8,0,0,0" Click="ImportApplyButton_Click" />
                        </StackPanel>

                        <Separator Margin="0,16" />
                        <TextBlock Text="导出明文快照" FontWeight="SemiBold" />
                        <DockPanel Margin="0,6,0,8">
                            <Button Content="选择文件夹" MinWidth="90" DockPanel.Dock="Left" Click="BrowseExportButton_Click" />
                            <TextBox x:Name="ExportDestinationTextBox" Margin="8,0,0,0" MinHeight="30" Padding="8,4" />
                        </DockPanel>
                        <Button Content="导出快照" HorizontalAlignment="Left" MinWidth="130" Click="ExportButton_Click" />

                        <Separator Margin="0,16" />
                        <TextBlock Text="备份与恢复" FontWeight="SemiBold" />
                        <Button Content="保存加密备份" HorizontalAlignment="Left" MinWidth="170" Margin="0,6,0,8" Click="BackupButton_Click" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="RestoreCredentialTypeComboBox" Width="110" MinHeight="30"
                                      Margin="0,0,8,0" SelectedIndex="0"
                                      SelectionChanged="RestoreCredentialTypeComboBox_SelectionChanged">
                                <ComboBoxItem Content="备份密码" />
                                <ComboBoxItem Content="恢复密钥" />
                            </ComboBox>
                            <PasswordBox x:Name="RestorePasswordBox" Grid.Column="1" MinHeight="30"
                                         Padding="8,4" VerticalContentAlignment="Center" />
                            <PasswordBox x:Name="RestoreRecoveryKeyBox" Grid.Column="1" MinHeight="30"
                                         Padding="8,4" VerticalContentAlignment="Center" FontFamily="Consolas"
                                         Visibility="Collapsed" ToolTip="可粘贴离线恢复密钥，空格和连字符会自动忽略。" />
                        </Grid>
                        <DockPanel Margin="0,0,0,8">
                            <Button Content="打开备份" MinWidth="100" DockPanel.Dock="Left" Click="OpenBackupFileButton_Click" />
                            <TextBox x:Name="RestoreBackupTextBox" Margin="8,0,0,0" MinHeight="30" Padding="8,4" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button Content="恢复目标" MinWidth="100" DockPanel.Dock="Left" Click="BrowseRestoreTargetButton_Click" />
                            <TextBox x:Name="RestoreTargetTextBox" Margin="8,0,0,0" MinHeight="30" Padding="8,4" />
                        </DockPanel>
                        <Button Content="恢复备份" HorizontalAlignment="Left" MinWidth="130" Margin="0,0,0,8" Click="RestoreBackupButton_Click" />

                        <Separator Margin="0,16" />
                        <TextBlock Text="维护" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,8">
                            <Button Content="校验" MinWidth="90" Click="VerifyButton_Click" />
                            <Button Content="重建搜索索引" MinWidth="110" Margin="8,0,0,0" Click="RebuildButton_Click" />
                            <Button Content="审计日志" MinWidth="90" Margin="8,0,0,0" Click="AuditButton_Click" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="修改密码" MinWidth="120" Click="ChangePasswordButton_Click" />
                            <Button Content="轮换恢复密钥" MinWidth="140" Margin="8,0,0,0" Click="RotateRecoveryButton_Click" />
                        </StackPanel>
                        <TextBlock Text="新密码" Margin="0,12,0,0" />
                        <PasswordBox x:Name="NewPasswordBox" MinHeight="30" Padding="8,4" Margin="0,4,0,6" />
                        <TextBlock Text="确认新密码" />
                        <PasswordBox x:Name="ConfirmNewPasswordBox" MinHeight="30" Padding="8,4" Margin="0,4,0,12" />
                        <TextBox x:Name="MaintenanceOutput" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="160" VerticalScrollBarVisibility="Auto"
                                 Padding="10" FontFamily="Consolas" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
