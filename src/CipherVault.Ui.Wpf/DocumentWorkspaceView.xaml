<UserControl x:Class="CipherVault.Ui.Wpf.DocumentWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,10,0,8" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="EditButton" Content="编辑" MinWidth="72"
                        Click="EditButton_Click" />
                <Button x:Name="SaveButton" Content="保存" MinWidth="72"
                        Margin="8,0,0,0" IsEnabled="False"
                        Click="SaveButton_Click" />
                <Button x:Name="CancelButton" Content="取消" MinWidth="72"
                        Margin="8,0,0,0" IsEnabled="False"
                        Click="CancelButton_Click" />
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="DocumentTitle" FontSize="20"
                           FontWeight="SemiBold" Text="选择一篇文档" />
                <TextBlock x:Name="DocumentMeta" Foreground="#667085"
                           Margin="0,3,0,0" Text="" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="360" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="340" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <RichTextBox x:Name="PreviewBox" IsReadOnly="True"
                             IsDocumentEnabled="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             Padding="12" />
                <TextBox x:Name="EditorBox" Visibility="Collapsed"
                         AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Cascadia Mono, Consolas"
                         Padding="12"
                         TextChanged="EditorBox_TextChanged" />
            </Grid>

            <GridSplitter Grid.Column="1" Width="8"
                          HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <TabControl x:Name="ContextTabs" Grid.Column="2" Margin="6,0,0,0">
                <TabItem Header="反向链接">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="BacklinkSummary" Foreground="#667085"
                                   Text="尚无反向链接" />
                        <ListBox x:Name="BacklinkList" Grid.Row="1"
                                 Margin="0,6,0,6"
                                 MouseDoubleClick="BacklinkList_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Summary}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detail}"
                                                   Foreground="#667085"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button x:Name="LoadMoreBacklinksButton"
                                Grid.Row="2" Content="加载更多"
                                HorizontalAlignment="Left"
                                Click="LoadMoreBacklinksButton_Click" />
                    </Grid>
                </TabItem>

                <TabItem Header="未解析">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="UnresolvedSummary" Foreground="#667085"
                                   Text="没有未解析链接" />
                        <ListBox x:Name="UnresolvedList" Grid.Row="1"
                                 Margin="0,6,0,0"
                                 MouseDoubleClick="UnresolvedList_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Summary}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detail}"
                                                   Foreground="#667085"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>

                <TabItem Header="局部图谱">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="深度" VerticalAlignment="Center" />
                                <ComboBox x:Name="GraphDepthComboBox"
                                          Margin="8,0,0,0" Width="70"
                                          SelectedIndex="0">
                                    <ComboBoxItem Content="1" />
                                    <ComboBoxItem Content="2" />
                                </ComboBox>
                                <Button Content="刷新图谱" MinWidth="90"
                                        Margin="8,0,0,0"
                                        DockPanel.Dock="Right"
                                        Click="RefreshGraphButton_Click" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="标签" VerticalAlignment="Center" />
                                <TextBox x:Name="GraphTagsTextBox"
                                         Margin="8,0,0,0"
                                         ToolTip="多个标签用逗号分隔，按 AND 过滤" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="文件夹" VerticalAlignment="Center" />
                                <TextBox x:Name="GraphFolderTextBox"
                                         Margin="8,0,0,0" />
                            </DockPanel>
                            <TextBlock x:Name="GraphSummary" Foreground="#667085"
                                       Margin="0,2,0,6" Text="选择文档后加载图谱" />
                        </StackPanel>
                        <Border x:Name="GraphHost" Grid.Row="1"
                                Background="#FAFBFC" />
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
