<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <RootNamespace>CipherVault.Server</RootNamespace>
    <AssemblyName>CipherVault.Server</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <CipherVaultReleaseVersion Condition="'$(CipherVaultReleaseVersion)' == ''">0.0.0-local</CipherVaultReleaseVersion>
    <CipherVaultBuildCommit Condition="'$(CipherVaultBuildCommit)' == ''">$(SourceRevisionId)</CipherVaultBuildCommit>
    <CipherVaultBuildCommit Condition="'$(CipherVaultBuildCommit)' == ''">local</CipherVaultBuildCommit>
    <CipherVaultBuildTimestampUtc Condition="'$(CipherVaultBuildTimestampUtc)' == ''">$([System.DateTime]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ss.fffffffZ'))</CipherVaultBuildTimestampUtc>
    <Version>$(CipherVaultReleaseVersion)</Version>
    <InformationalVersion>$(CipherVaultReleaseVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CipherVault.Application\CipherVault.Application.csproj" />
    <ProjectReference Include="..\CipherVault.Core\CipherVault.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="CipherVault.ProductVersion" Value="$(CipherVaultReleaseVersion)" />
    <AssemblyMetadata Include="CipherVault.Commit" Value="$(CipherVaultBuildCommit)" />
    <AssemblyMetadata Include="CipherVault.BuildTimestampUtc" Value="$(CipherVaultBuildTimestampUtc)" />
  </ItemGroup>
</Project>
