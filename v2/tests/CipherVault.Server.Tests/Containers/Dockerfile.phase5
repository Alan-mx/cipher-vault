FROM mcr.microsoft.com/dotnet/sdk:10.0.402-noble@sha256:747cbade5bfd918a175ac32f8f1d931edec2c7d0d5397a3de72eaef1ac1f66d2

ENV NUGET_PACKAGES=/nuget/packages

WORKDIR /src

COPY Directory.Build.props Directory.Build.props
COPY global.json global.json
COPY v2/Directory.Packages.props v2/Directory.Packages.props
COPY v2/src/CipherVault.Core/CipherVault.Core.csproj v2/src/CipherVault.Core/
COPY v2/src/CipherVault.Core/packages.lock.json v2/src/CipherVault.Core/
COPY v2/src/CipherVault.Application/CipherVault.Application.csproj v2/src/CipherVault.Application/
COPY v2/src/CipherVault.Application/packages.lock.json v2/src/CipherVault.Application/
COPY v2/src/CipherVault.Server/CipherVault.Server.csproj v2/src/CipherVault.Server/
COPY v2/src/CipherVault.Server/packages.lock.json v2/src/CipherVault.Server/

RUN dotnet restore v2/src/CipherVault.Server/CipherVault.Server.csproj \
        --locked-mode \
        -p:NuGetAudit=false \
    && chmod -R a+rX /nuget

COPY v2/src/CipherVault.Core v2/src/CipherVault.Core
COPY v2/src/CipherVault.Application v2/src/CipherVault.Application
COPY v2/src/CipherVault.Server v2/src/CipherVault.Server

RUN dotnet build v2/src/CipherVault.Server/CipherVault.Server.csproj \
        -c Release \
        --no-restore \
        -warnaserror \
    && useradd --uid 10001 --create-home --shell /usr/sbin/nologin cipher-vault \
    && mkdir -p /data/vault /data/config \
    && chown -R 10001:10001 /src /data

ENV ASPNETCORE_URLS=http://0.0.0.0:43127
ENV CIPHERVAULT_CONTAINER_MODE=true
ENV CIPHERVAULT_ALLOWED_HOSTS=127.0.0.1,localhost
ENV CIPHERVAULT_DATA_DIR=/data/vault
ENV CIPHERVAULT_CONFIG_DIR=/data/config

USER 10001:10001

ENTRYPOINT ["dotnet", "v2/src/CipherVault.Server/bin/Release/net10.0/CipherVault.Server.dll"]
