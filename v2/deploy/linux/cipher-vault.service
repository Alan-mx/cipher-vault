[Unit]
Description=CipherVault Personal Knowledge Base
After=network.target

[Service]
Type=simple
User=cipher-vault
Group=cipher-vault
WorkingDirectory=/opt/cipher-vault
ExecStart=/opt/cipher-vault/CipherVault.Server
Restart=on-failure
RestartSec=5
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:43127
Environment=HOME=/var/lib/cipher-vault
Environment=CIPHERVAULT_DATA_DIR=/var/lib/cipher-vault/data
Environment=CIPHERVAULT_CONFIG_DIR=/var/lib/cipher-vault/config
Environment=CIPHERVAULT_BACKUP_DIR=/var/lib/cipher-vault/backups
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=cipher-vault
StateDirectoryMode=0700
ReadWritePaths=/var/lib/cipher-vault
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
